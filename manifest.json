{
  "manifest_version": 3,
  "name": "CollabFox for Blackboard",
  "version": "1.0.3",
  "description": "Enables Blackboard Collaborate on Firefox Desktop and Android by neutralizing artificial browser barriers.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "CollabFox"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "collabfox@chafic.org",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.bbcollab.com/*",
    "*://*.class.com/*",
    "*://*.collab.blackboard.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.bbcollab.com/*",
        "*://*.class.com/*",
        "*://*.collab.blackboard.com/*"
      ],
      "js": ["shim.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.bbcollab.com/*",
        "*://*.class.com/*",
        "*://*.collab.blackboard.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}